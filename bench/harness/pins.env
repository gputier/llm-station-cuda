# Long-context suites (ruler.Dockerfile, longbench.Dockerfile). Read with:
# gh api repos/<owner>/<repo>/commits/main --jq .sha
RULER_SHA=c3f5e3b4f87f97e048793bb510a3a6b19a46bf3a
# RULER's essay haystack (niah_single_2, niah_single_3, niah_multikey_1,
# niah_multivalue, niah_multiquery) is assembled at build time from 218 URLs
# listed in the pinned repo's own scripts/data/synthetic/json/PaulGrahamEssays_URLs.txt
# (fixed by RULER_SHA), using the pinned repo's own download_paulgraham_essay.py
# unmodified. No single URL to pin for the assembled corpus itself, so the
# build verifies its sha256 against this pin instead (measured 2026-09-24,
# gh api / html2text 2020.1.16 / beautifulsoup4 4.14.2, 3108618 bytes); the
# build fails loudly if any of the 218 pages served different bytes.
RULER_ESSAY_CORPUS_SHA256=58e352531a80cef2d22c205dbebfbfd64a8afe55a32434de845f200718756c65
# QA datasets for qa_1 (squad) and qa_2 (hotpotqa), read from the pinned repo's
# own scripts/data/synthetic/json/download_qa_dataset.sh (RULER_SHA). Measured
# 2026-09-24.
RULER_SQUAD_URL=https://rajpurkar.github.io/SQuAD-explorer/dataset/dev-v2.0.json
