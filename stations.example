# Template for the environment file the entry point and compose.yaml read.
# The repository's write hook refuses any file named .env* (plan Task 16), so
# this template is not one: copy it to a file OUTSIDE this convention (for
# instance a path in your own scratchpad, never committed) and fill in the
# real values, then pass that path with "python -m benchrun run --env <path>"
# or "BENCH_ENV=<path>", and with "docker compose --env-file <path> ..." for
# compose.yaml's own variable substitution.
STATION_99_SSH=user@host
STATION_99_URL=http://host:8080
STATION_97_SSH=user@host
STATION_97_URL=http://host:8080
# Absolute path to the private companion checkout (tasks/, sets/, runs/):
# mounted at the SAME path inside the runner and gateway containers (see the
# note at the top of harness/compose.yaml), never inside this repo.
BENCH_PRIVATE=/private
# Not a line to copy into this file: compose.yaml reads SSH_AUTH_SOCK from
# your own shell (docker compose --env-file <this file> ...), forwarding the
# host's ssh-agent socket so a Keychain/agent-backed key still authenticates
# from inside the runner container (found live, Task 16 pilot: no bare key
# file under ~/.ssh authenticates on its own for these stations).
