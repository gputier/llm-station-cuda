#!/usr/bin/env bash
# spark - Claude Code on Spark-X2.5-4B, served by the 32 GB box.
#
# CANDIDATE since 2026-09-10, replacing nothing. Running it STOPS whatever else
# holds the card, one model at a time. Come back with `tiel` or `kat`.
#
# Four billion parameters against thirty-five for tiel, which is the point: it
# is here to be tried as an agentic worker, not as a coder. Its architecture
# needs llama.cpp b10828 or later; the fork its model card sends you to compile
# is obsolete and must not be built.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.
#
# One variant, so no menu and nothing to answer. Everything else lives in
# llm-launch.sh.

source "$(dirname "${BASH_SOURCE[0]}")/llm-launch.sh"
# Four billion parameters load faster than the 240 s the others are given.
LLM_LOAD_TIMEOUT=180

llm_variant "Spark-X2.5-4B sur la machine 32 Go, fenêtre 262k" "${LLM_HOST:-your-32gb-box}" spark spark-x2.5 '' spark-x2.5-4b 262144

llm_launch "$@"
