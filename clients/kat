#!/usr/bin/env bash
# kat - Claude Code on KAT-Coder-V2.5-Dev-35B-A3B, served by the 32 GB box.
#
# ON TRIAL since 2026-09-08. This model replaces nothing: it is the only one of
# four candidates benched that day to match Tiel everywhere and beat it on
# generated code (295.1 against 284.3 tok/s). Running it STOPS Tiel, one model
# at a time on this card. Come back with `tiel`.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.
#
# One variant, so no menu and nothing to answer. It matches on its own model
# directory, kat-coder-v25: the APEX build served by katapex carries
# "kat-coder" too. Everything else lives in llm-launch.sh.

source "$(dirname "${BASH_SOURCE[0]}")/llm-launch.sh"

llm_variant "KAT-Coder sur la machine 32 Go" "${LLM_HOST:-your-32gb-box}" kat kat-coder-v25 '' kat-coder-v25-35b-a3b 262144

# Profils du banc (bench/benchrun/profiles.py), un par config bench/configs.
llm_variant "R1, réglage de référence, réflexion activée, machine 32 Go" \
  "${LLM_HOST:-your-32gb-box}" "profile -Name kat-r1" kat-r1 '' kat-r1 393216 81920
llm_variant "R2, réflexion désactivée, réponse directe, machine 32 Go" \
  "${LLM_HOST:-your-32gb-box}" "profile -Name kat-r2" kat-r2 '' kat-r2 393216 32768
llm_variant "R3, cache mémoire réduit, non confirmé, machine 32 Go" \
  "${LLM_HOST:-your-32gb-box}" "profile -Name kat-r3" kat-r3 '' kat-r3 393216 81920

llm_launch "$@"
