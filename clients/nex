#!/usr/bin/env bash
# nex - Claude Code on Nex-N2.5-mini, served by the 32 GB box.
#
# CANDIDATE since 2026-09-10, replacing nothing. Running it STOPS whatever else
# holds the card, one model at a time. Come back with `tiel` or `kat`.
#
# Two things to know before trusting it with real work. It has NO speculative
# decoding: its config declares an MTP head that its weights do not ship, so it
# gives up the trick that makes tiel and kat fast. And its vision is served by a
# projector sitting on an OPEN llama.cpp defect, issue 27931: the server crashes
# on this family of models when text and image turns alternate in one
# conversation. A single image in a single turn may well pass.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.
#
# One variant, so no menu and nothing to answer. Everything else lives in
# llm-launch.sh.

source "$(dirname "${BASH_SOURCE[0]}")/llm-launch.sh"

llm_variant "Nex-N2.5-mini sur la machine 32 Go, fenêtre 262k" "${LLM_HOST:-your-32gb-box}" nex nex-n2.5 '' nex-n2.5-mini 262144

llm_launch "$@"
