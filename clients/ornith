#!/usr/bin/env bash
# ornith - Claude Code on Ornith-1.5-9B, served by the 32 GB box.
#
# The small one: a third of the VRAM of the others, and 83.4% on the
# 500-question MMLU set of 2026-09-10. A fast second opinion and short tasks.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.
#
# One variant, so no menu and nothing to answer. Everything else lives in
# llm-launch.sh.

source "$(dirname "${BASH_SOURCE[0]}")/llm-launch.sh"

llm_variant "Ornith-1.5-9B sur la machine 32 Go, fenêtre 262k" "${LLM_HOST:-your-32gb-box}" ornith ornith-1.5-9b '' ornith-1.5-9b 262144

llm_launch "$@"
