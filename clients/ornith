#!/usr/bin/env bash
# ornith - Claude Code on Ornith-1.5-9B, served by the 32 GB box.
#
# The small one: a third of the VRAM of the others, and 83.4% on the
# 500-question MMLU set of 2026-09-10. A fast second opinion and short tasks.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.
#
# One variant, so no menu and nothing to answer. Everything else lives in
# llm-launch.sh.

source "$(dirname "${BASH_SOURCE[0]}")/llm-launch.sh"

llm_variant "Ornith-1.5-9B sur la machine 32 Go" "${LLM_HOST:-your-32gb-box}" ornith ornith-1.5-9b '' ornith-1.5-9b 262144

# Profils du banc (bench/benchrun/profiles.py), un par config bench/configs.
llm_variant "R1, réglage de référence, usage général, machine 32 Go" \
  "${LLM_HOST:-your-32gb-box}" "profile -Name ornith-r1" ornith-r1 '' ornith-r1 262144 81920
llm_variant "R2, cache mémoire ajusté, non confirmé pour ce modèle, machine 32 Go" \
  "${LLM_HOST:-your-32gb-box}" "profile -Name ornith-r2" ornith-r2 '' ornith-r2 262144 81920
llm_variant "R3, fenêtre étendue, rappel non prouvé, machine 32 Go" \
  "${LLM_HOST:-your-32gb-box}" "profile -Name ornith-r3" ornith-r3 '' ornith-r3 393216 131072

llm_launch "$@"
