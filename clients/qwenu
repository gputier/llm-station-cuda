#!/usr/bin/env bash
# qwenu - launch Claude Code against the local Qwen3.8-27B Uncensored server.
#
# Sibling of `muse` and `qwen`. Same mechanism: the llama.cpp build serving these
# models exposes a native Anthropic-compatible /v1/messages endpoint, including
# SSE streaming, count_tokens and tool_use blocks. Only the base URL is
# redirected, no translation proxy involved.
#
# This targets the abliterated build. Use it only when the aligned Qwen refuses a
# legitimate task; `qwen` stays the reasoning and coding model.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.

set -euo pipefail

HOST="${LLM_HOST:-llm-server.local}"
PORT="8080"
BASE="http://${HOST}:${PORT}"
SSH_TARGET="${LLM_SSH_USER:-youruser}@${HOST}"
CTL='D:\LLM-Setup\llm-ctl.ps1'
LOAD_TIMEOUT=180

err() { printf '%s\n' "$*" >&2; }

is_up() { curl -sS -m 3 "${BASE}/health" 2>/dev/null | grep -q '"status":"ok"'; }

# The server is single-slot: whichever model sits on port 8080 answers every
# request, whatever model id the client asks for. Checking health is therefore
# not enough, we must confirm the uncensored build is the one loaded.
loaded_model() {
  curl -sS -m 3 "${BASE}/props" 2>/dev/null \
    | sed -n 's/.*"model_path":"\([^"]*\)".*/\1/p'
}

# The uncensored build is the only one carrying "uncensored" in its path; the
# aligned Qwen shares the "qwen3.8" prefix, so that alone would not discriminate.
is_qwenu() { loaded_model | grep -qi 'uncensored'; }

load_qwenu() {
  err "Loading Qwen3.8-27B Uncensored on ${HOST}..."
  ssh -o ConnectTimeout=10 "$SSH_TARGET" \
    "powershell -NoProfile -ExecutionPolicy Bypass -File ${CTL} -Action qwenu" >&2

  local waited=0
  while (( waited < LOAD_TIMEOUT )); do
    if is_up && is_qwenu; then
      err "Qwen3.8-27B Uncensored ready."
      return 0
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done

  err "Failed: the model did not answer within ${LOAD_TIMEOUT}s."
  err "See D:\\LLM-Setup\\llm-err-qwenu.log on ${HOST}."
  return 1
}

if ! is_up; then
  load_qwenu
elif ! is_qwenu; then
  err "Port ${PORT} is serving $(loaded_model | sed 's/.*\\//'), not Qwen Uncensored."
  read -r -p "Replace it with Qwen3.8-27B Uncensored? [y/N] " answer
  [[ "$answer" =~ ^[yY]$ ]] || { err "Aborted."; exit 1; }
  load_qwenu
fi

# AUTH_TOKEN and not API_KEY: the latter triggers Claude Code's custom-key
# approval prompt. llama-server started without --api-key accepts any bearer.
export ANTHROPIC_AUTH_TOKEN="local"
export ANTHROPIC_BASE_URL="$BASE"

# Every model id resolves to the single loaded model, but naming them keeps the
# UI honest and stops Claude Code from reaching for a real Anthropic model.
export ANTHROPIC_MODEL="qwen3.8-27b-uncensored"
export ANTHROPIC_DEFAULT_OPUS_MODEL="qwen3.8-27b-uncensored"
export ANTHROPIC_DEFAULT_SONNET_MODEL="qwen3.8-27b-uncensored"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="qwen3.8-27b-uncensored"
export ANTHROPIC_SMALL_FAST_MODEL="qwen3.8-27b-uncensored"

# 253_952 = the 262_144 the server serves, MINUS the 8_192 of output below.
#
# It said 262_144 until 2026-09-10, the whole window. This variable is an INPUT
# budget, not the window: n_ctx counts input and output in one pool, so
# announcing all of it lets the client fill the last token, after which the
# server has no room left to write and returns an empty response. That is the
# lesson of 2026-09-08, paid for with a working session.
#
# Change one of these two numbers, change the other. The authority is
# default_generation_settings.n_ctx in /props, never --ctx-size.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=253952
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192

# Telemetry and update pings would otherwise be aimed at the local server.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# MCP servers are dropped, and this is not cosmetic. Measured on `muse`, the full
# Claude Code prompt is 109_738 tokens, 70 tool schemas weighing 108 KB on their
# own. That overhead buys little here and costs a much slower first turn, and it
# bites harder on a 262k window than it did on 1M.
# Skills, commands, memory and CLAUDE.md are untouched.
exec claude --strict-mcp-config --mcp-config '{"mcpServers":{}}' "$@"
