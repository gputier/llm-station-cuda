#!/usr/bin/env bash
# muse - Claude Code on Muse Glimmer 30B, served by the 32 GB box.
#
# Agentic multi-turn work, vision and faithful OCR. Its window was brought down
# from 1,048,576 to 262,144 on 2026-08-31, a million tokens costing more than
# they returned; the model still reaches a million, recall proven at 556,390
# tokens, this box just does not serve it there.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.
#
# One variant, so no menu and nothing to answer. Everything else lives in
# llm-launch.sh.

source "$(dirname "${BASH_SOURCE[0]}")/llm-launch.sh"

# Muse loads faster than the 240 s the others are given.
LLM_LOAD_TIMEOUT=180

llm_variant "Muse Glimmer 30B sur la machine 32 Go" "${LLM_HOST:-your-32gb-box}" muse muse-glimmer '' muse-glimmer-30b 262144

# Profils du banc (bench/benchrun/profiles.py), un par config bench/configs.
llm_variant "R1, réglage de référence, tel que publié, machine 32 Go" \
  "${LLM_HOST:-your-32gb-box}" "profile -Name muse-r1" muse-r1 '' muse-r1 262144 65536
llm_variant "R2, fenêtre étendue au million de jetons, à reprouver, machine 32 Go" \
  "${LLM_HOST:-your-32gb-box}" "profile -Name muse-r2" muse-r2 '' muse-r2 1048576 65536
llm_variant "R3, encodeur d'image alternatif, écarté à l'origine faute de mémoire, machine 32 Go" \
  "${LLM_HOST:-your-32gb-box}" "profile -Name muse-r3" muse-r3 '' muse-r3 262144 65536

llm_launch "$@"
