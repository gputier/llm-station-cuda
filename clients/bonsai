#!/usr/bin/env bash
# bonsai - Claude Code on Ternary-Bonsai-27B, served by the 32 GB box.
#
# CANDIDATE since 2026-09-10, replacing nothing. Running it STOPS whatever else
# holds the card, one model at a time. Come back with `tiel` or `kat`.
#
# Twenty-seven billion parameters in 7 GiB: the weights are ternary, {-1, 0, +1}
# with group-wise scaling, about 1.71 bits each. The file served is Q2_g64, the
# variant meant for upstream llama.cpp; the PQ2_0 file in the same repository
# needs PrismML's own fork and is deliberately not used here.
#
# Its drafter may refuse to load, llama.cpp issue 26337, open and never fixed.
# If the server dies at startup complaining about a dspark tensor offset, drop
# the three speculation flags from the profile: the model still serves without
# them, only the 1.34x speed claim goes.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.
#
# One variant, so no menu and nothing to answer. Everything else lives in
# llm-launch.sh.

source "$(dirname "${BASH_SOURCE[0]}")/llm-launch.sh"

llm_variant "Ternary-Bonsai-27B sur la machine 32 Go, fenêtre 262k" "${LLM_HOST:-your-32gb-box}" bonsai bonsai '' ternary-bonsai-27b 262144

llm_launch "$@"
