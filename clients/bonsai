#!/usr/bin/env bash
# bonsai - launch Claude Code against the local Ternary-Bonsai-27B server.
#
# Sibling of `kat` and `tiel`, same mechanism: the llama.cpp build serving this
# model exposes a native Anthropic-compatible /v1/messages endpoint, SSE and
# tool_use included, so no translation proxy is involved.
#
# CANDIDATE since 2026-09-10, replacing nothing. Running it STOPS whatever else
# holds the card, one model at a time. Come back with `tiel` or `kat`.
#
# Twenty-seven billion parameters in 7 GiB: the weights are ternary, {-1, 0, +1}
# with group-wise scaling, about 1.71 bits each. The file served is Q2_g64, the
# variant meant for upstream llama.cpp; the PQ2_0 file in the same repository
# needs PrismML's own fork and is deliberately not used here.
#
# Its drafter may refuse to load, llama.cpp issue 26337, open and never fixed.
# If the server dies at startup complaining about a dspark tensor offset, drop
# the three speculation flags from the profile: the model still serves without
# them, only the 1.34x speed claim goes.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.

set -euo pipefail

HOST="${LLM_HOST:-your-server-hostname-or-ip}"
PORT="8080"
BASE="http://${HOST}:${PORT}"
SSH_TARGET="${LLM_SSH_USER:-youruser}@${HOST}"
# Explicit key, and IdentitiesOnly with it. The agent on this Mac holds six keys
# and offers them all: the box refuses at the sixth with "Too many
# authentication failures" before the right one is ever tried.
SSH_KEY="${LLM_SSH_KEY:-$HOME/.ssh/id_ed25519}"
SSH_OPTS=(-o IdentitiesOnly=yes -i "$SSH_KEY" -o ConnectTimeout=10)
CTL='D:\LLM-Setup\llm-ctl.ps1'
LOAD_TIMEOUT=240

err() { printf '%s\n' "$*" >&2; }

is_up() { curl -sS -m 3 "${BASE}/health" 2>/dev/null | grep -q '"status":"ok"'; }

# The server is single-slot: whichever model sits on port 8080 answers every
# request, whatever model id the client asks for. Checking health is therefore
# not enough, we must confirm this model is the one loaded.
loaded_model() {
  curl -sS -m 3 "${BASE}/props" 2>/dev/null \
    | sed -n 's/.*"model_path":"\([^"]*\)".*/\1/p'
}

is_bonsai() { printf '%s' "$(loaded_model)" | grep -qi 'bonsai'; }

load_bonsai() {
  err "Chargement de Ternary-Bonsai-27B sur ${HOST}..."
  ssh "${SSH_OPTS[@]}" "$SSH_TARGET" \
    "powershell -NoProfile -ExecutionPolicy Bypass -File ${CTL} -Action bonsai" >&2

  local waited=0
  while (( waited < LOAD_TIMEOUT )); do
    if is_up && is_bonsai; then
      err "Bonsai prêt."
      return 0
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done

  err "Échec : le modèle n'a pas répondu en ${LOAD_TIMEOUT} s."
  err "Journal : ssh ${SSH_TARGET} \"powershell -NoProfile -ExecutionPolicy Bypass -File ${CTL} -Action logs -Name bonsai\""
  err "Ou directement D:\\LLM-Setup\\llm-err-bonsai.log sur ${HOST}."
  err "Si le journal parle d'un décalage sur dspark.fc.weight, c'est le brouillon"
  err "de spéculation : retirer --spec-type, --spec-draft-n-max et -md du profil."
  return 1
}

if ! is_up; then
  load_bonsai
elif ! is_bonsai; then
  err "Le port ${PORT} sert « $(loaded_model | sed 's/.*\\//') », pas Bonsai."
  read -r -p "Le remplacer par Bonsai ? [o/N] " answer
  [[ "$answer" =~ ^[oOyY]$ ]] || { err "Abandon."; exit 1; }
  load_bonsai
fi

# AUTH_TOKEN and not API_KEY: the latter triggers Claude Code's custom-key
# approval prompt. llama-server started without --api-key accepts any bearer.
export ANTHROPIC_AUTH_TOKEN="local"
export ANTHROPIC_BASE_URL="$BASE"

export ANTHROPIC_MODEL="ternary-bonsai-27b"
export ANTHROPIC_DEFAULT_OPUS_MODEL="ternary-bonsai-27b"
export ANTHROPIC_DEFAULT_SONNET_MODEL="ternary-bonsai-27b"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="ternary-bonsai-27b"
export ANTHROPIC_SMALL_FAST_MODEL="ternary-bonsai-27b"

# 245_760 = the 262_144 the server serves, MINUS the 16_384 of output below.
# This variable is an INPUT budget, not the window: n_ctx counts input and
# output in one pool, so announcing the total lets the client fill the last
# token, after which the server has no room left to write and returns an EMPTY
# response. That cost a working session on 2026-09-08.
#
# The rule: n_ctx minus CLAUDE_CODE_MAX_OUTPUT_TOKENS. Change one, change the
# other. The authority is default_generation_settings.n_ctx in /props, never the
# --ctx-size passed to the server.
#
# Recall in this window is NOT proven on these weights, and ternary weights give
# a reason to doubt it more than usual: quality lost to quantisation shows up
# first on long-range recall. Treat long sessions with suspicion.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=245760
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=16384

# Read for PRESENCE, not for value: any non-empty string turns the disabling ON.
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Read by VALUE, unlike the line above. Dropping the attribution block keeps the
# first tokens of every request stable, so the server recognises the
# conversation as a continuation instead of re-prefilling the whole context.
export CLAUDE_CODE_ATTRIBUTION_HEADER=0

# MCP servers dropped: 70 tool schemas weigh 108 KB of prompt on their own, which
# buys little here and costs a much slower first turn. Skills, commands, memory
# and CLAUDE.md are untouched.
exec claude --strict-mcp-config --mcp-config '{"mcpServers":{}}' "$@"
