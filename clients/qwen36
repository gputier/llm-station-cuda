#!/usr/bin/env bash
# qwen36 - Claude Code on Qwen3.6-35B-A3B, served by the 16 GB box.
#
# Bench-only entries: no hand-written production profile exists for this
# model's launcher, only the three profiles the bench compared
# (bench/configs/97/qwen36). The menu below asks which one to load.
#
# Scope: the exported variables live in this process only. A plain `claude` in
# another shell keeps talking to Anthropic.

source "$(dirname "${BASH_SOURCE[0]}")/llm-launch.sh"

# Profils du banc (bench/benchrun/profiles.py), un par config bench/configs.
llm_variant "R1, réglage complet de la fiche, pénalité de répétition restaurée, machine 16 Go" \
  "${LLM_HOST_16GB:-your-16gb-box}" "profile -Name qwen36-r1" qwen36-r1 '' qwen36-r1 262144 '' 81920
llm_variant "R2, répartition mémoire ciblée, lancé sans le réglage d'origine, machine 16 Go" \
  "${LLM_HOST_16GB:-your-16gb-box}" "profile -Name qwen36-r2" qwen36-r2 '' qwen36-r2 262144 '' 81920
llm_variant "R3, gabarit de dialogue alternatif, hypothèse non confirmée, machine 16 Go" \
  "${LLM_HOST_16GB:-your-16gb-box}" "profile -Name qwen36-r3" qwen36-r3 '' qwen36-r3 262144 '' 81920

llm_launch "$@"
